# Copy to .env and edit. Every JANNYQ_* variable has a matching command-line
# flag (JANNYQ_LLM_MODEL <-> --llm-model); run `jannyq --help` for the full list.

# --- Model ------------------------------------------------------------------
# Ollama (native API). Pick a model with tool-calling support, e.g. qwen3, llama3.1, mistral-nemo.
JANNYQ_LLM_PROVIDER=ollama
JANNYQ_LLM_MODEL=qwen3:8b
# Same model name for the ollama-pull helper service in docker-compose.yml.
MODEL=qwen3:8b
# Context window of the model in tokens. Sent to Ollama as num_ctx (Ollama's
# default is small!) and used to decide when to compact old messages.
JANNYQ_CONTEXT_SIZE=16384

# OpenAI-compatible API instead (OpenAI, vLLM, LM Studio, ...):
# JANNYQ_LLM_PROVIDER=openai
# JANNYQ_LLM_BASE_URL=https://api.openai.com/v1
# JANNYQ_LLM_API_KEY=sk-...
# JANNYQ_LLM_MODEL=gpt-4o-mini

# --- Language ---------------------------------------------------------------
# Main language of bot messages and replies (en, th, ...).
JANNYQ_LANG=th
# follow-user: mirror the user's language; default: always JANNYQ_LANG.
JANNYQ_LANG_MODE=follow-user

# --- Channels ---------------------------------------------------------------
# Create a bot with @BotFather. In groups the bot answers when mentioned or replied to.
JANNYQ_TELEGRAM_TOKEN=

# --- Commands and skills ------------------------------------------------------
# off | sandbox (recommended) | host (unsafe: runs commands on the bot's own machine)
JANNYQ_RUN_COMMAND=sandbox
# Shared secret between jannyq and the sandbox container. REQUIRED. Generate with: openssl rand -hex 32
JANNYQ_SANDBOX_TOKEN=
# run_command calls per user per minute (0 = unlimited).
JANNYQ_RUN_RATE=10
# Whether the sandbox has internet access (see docker-compose.egress.yml; keep "off" by default).
JANNYQ_SANDBOX_NETWORK=off
# Skills live in ./skills (mounted at /skills): one folder per skill with a SKILL.md.

# --- Access control ---------------------------------------------------------
# Comma-separated user IDs (or channel:id) allowed to chat. Empty = everyone.
JANNYQ_ALLOWED_USERS=
# Messages per user per minute (0 = unlimited).
JANNYQ_RATE_LIMIT=20

# --- Misc -------------------------------------------------------------------
SEARXNG_SECRET=change-me-please
JANNYQ_LOG_LEVEL=info

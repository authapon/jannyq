# Copy to .env and edit. Every JANNYQ_* variable has a matching command-line
# flag (JANNYQ_LLM_MODEL <-> --llm-model); run `jannyq --help` for the full list.

# --- Model ------------------------------------------------------------------
# Ollama (native API). Pick a model with tool-calling support, e.g. qwen3, llama3.1, mistral-nemo.
JANNYQ_LLM_PROVIDER=ollama
JANNYQ_LLM_MODEL=qwen3:8b
# Same model name for the ollama-pull helper service in docker-compose.yml.
MODEL=qwen3:8b
# Context window of the model in tokens. Sent to Ollama as num_ctx (Ollama's
# default is small!) and used to decide when to compact old messages.
JANNYQ_CONTEXT_SIZE=16384

# OpenAI-compatible API instead (OpenAI, vLLM, LM Studio, ...):
# JANNYQ_LLM_PROVIDER=openai
# JANNYQ_LLM_BASE_URL=https://api.openai.com/v1
# JANNYQ_LLM_API_KEY=sk-...
# JANNYQ_LLM_MODEL=gpt-4o-mini

# --- Language ---------------------------------------------------------------
# Main language of bot messages and replies (en, th, ...).
JANNYQ_LANG=th
# follow-user: mirror the user's language; default: always JANNYQ_LANG.
JANNYQ_LANG_MODE=follow-user

# --- Time and groups ---------------------------------------------------------
# Zone of the timestamps the model sees (IANA name). Empty: Asia/Bangkok for JANNYQ_LANG=th, else the server's.
JANNYQ_TIMEZONE=
# all = remember every group message (so the model knows who said what); addressed = only those meant for the bot.
# For "all" on Telegram, turn privacy mode off in BotFather (/setprivacy -> Disable).
JANNYQ_GROUP_CONTEXT=all

# --- Channels ---------------------------------------------------------------
# Create a bot with @BotFather. In groups the bot answers when mentioned or replied to.
JANNYQ_TELEGRAM_TOKEN=

# Discord: create an application and bot at https://discord.com/developers, switch on
# "MESSAGE CONTENT INTENT" (Bot -> Privileged Gateway Intents), invite the bot to your server. No public URL needed.
JANNYQ_DISCORD_TOKEN=
# LINE: Messaging API channel from the LINE Developers console. LINE calls a webhook, so a public
# HTTPS URL is needed (docker-compose.public.yml): https://<JANNYQ_DOMAIN>/webhook/line
JANNYQ_LINE_CHANNEL_SECRET=
JANNYQ_LINE_CHANNEL_TOKEN=

# Messenger and WhatsApp (Meta). Both call a webhook, so a public HTTPS URL is needed (docker-compose.public.yml):
#   https://<JANNYQ_DOMAIN>/webhook/messenger   and   https://<JANNYQ_DOMAIN>/webhook/whatsapp
# The verify tokens are strings you invent and enter in the Meta console when subscribing the webhook.
JANNYQ_MESSENGER_PAGE_TOKEN=
JANNYQ_MESSENGER_APP_SECRET=
JANNYQ_MESSENGER_VERIFY_TOKEN=
JANNYQ_WHATSAPP_TOKEN=
JANNYQ_WHATSAPP_PHONE_NUMBER_ID=
JANNYQ_WHATSAPP_APP_SECRET=
JANNYQ_WHATSAPP_VERIFY_TOKEN=

# --- Pictures, PDFs and text files ---------------------------------------------
# Users can send them; the model reads pictures itself, so it must be a vision model
# (Ollama: gemma3, qwen2.5vl, llama3.2-vision, ...). auto asks Ollama (always on for openai); on | off.
JANNYQ_ATTACHMENTS=true
JANNYQ_VISION=auto
# Largest file in MB, files read per message, files per user per minute.
JANNYQ_ATTACH_MAX_MB=20
JANNYQ_ATTACH_PER_MESSAGE=5
JANNYQ_ATTACH_RATE=10
# Scanned PDFs: Tesseract languages (auto = eng, plus tha when JANNYQ_LANG=th; off disables OCR).
JANNYQ_OCR_LANGS=auto

# --- Knowledge base (RAG) -------------------------------------------------------
# At start-up the knowledge folder is checked and the index built completely BEFORE the bot starts
# (false: build it in the background while the bot already answers). A big folder can take a while.
JANNYQ_KNOWLEDGE_STARTUP_SYNC=true
# Text and PDF files in ./knowledge are indexed for everyone (JANNYQ_KNOWLEDGE_DIR is set in docker-compose.yml).
# Edits, deletions and renames are followed within about half a minute.
# Embedding model for semantic search (pulled by the ollama-pull helper). Empty = search by words only.
# Multilingual and good for Thai: bge-m3. Smaller, English-centred: nomic-embed-text.
JANNYQ_EMBED_MODEL=bge-m3

# --- Commands and skills ------------------------------------------------------
# off | sandbox (recommended) | host (unsafe: runs commands on the bot's own machine)
JANNYQ_RUN_COMMAND=sandbox
# Shared secret between jannyq and the sandbox container. REQUIRED. Generate with: openssl rand -hex 32
JANNYQ_SANDBOX_TOKEN=
# run_command calls per user per minute (0 = unlimited).
JANNYQ_RUN_RATE=10
# Whether the sandbox has internet access (see docker-compose.egress.yml; keep "off" by default).
JANNYQ_SANDBOX_NETWORK=off
# Skills live in ./skills (mounted at /skills): one folder per skill with a SKILL.md.

# --- Web chat and public access -----------------------------------------------
# Serve the chat page (needs docker-compose.public.yml for HTTPS on the internet).
JANNYQ_WEB=false
# Host name for HTTPS (docker-compose.public.yml); DNS must point at this server.
JANNYQ_DOMAIN=
# Visitors must enter this code before chatting. Empty = open to everyone.
JANNYQ_WEB_ACCESS_CODE=
# Web chat limits: messages per address per minute, and run_command calls per
# address per minute from the web (0 turns commands off there).
JANNYQ_WEB_IP_RATE=30
JANNYQ_WEB_RUN_RATE=3

# --- Operations ----------------------------------------------------------------------
# Automatic backups (see docs/DEPLOYMENT.md). docker-compose.yml sets JANNYQ_BACKUP_DIR=/backups.
JANNYQ_BACKUP_INTERVAL=24h
JANNYQ_BACKUP_KEEP=7
# Delete chats (messages and files) idle for this many days. 0 = keep for ever.
JANNYQ_RETENTION_DAYS=0
# Prometheus metrics on their own port (not published by the compose files). Set a token if you listen on more than loopback.
# JANNYQ_METRICS_LISTEN=:9100
# JANNYQ_METRICS_TOKEN=

# --- Access control ---------------------------------------------------------
# Comma-separated user IDs (or channel:id) allowed to chat. Empty = everyone.
# Examples: telegram:123456789,discord:80351110224678912,whatsapp:66812345678
# A user who is not listed is refused and the log shows their channel and id
# ("message from user that is not allowed"). Not usable with the web chat (random
# visitor ids): use JANNYQ_WEB_ACCESS_CODE there. Details: README, "Who may use the bot".
JANNYQ_ALLOWED_USERS=
# Group chat IDs (or channel:id) where EVERYBODY is answered, listed above or not.
# The two lists add up; with only this one set the bot answers in those groups only.
# Example: telegram:-1001234567890,discord:1098765432109876543
JANNYQ_ALLOWED_GROUPS=
# Chat commands /help /reset /compact. false = no slash commands at all (text starting
# with / is an ordinary message; the web chat hides its "New chat" button).
JANNYQ_COMMANDS=true
# The first time the bot answers in a chat, the model introduces itself (in JANNYQ_LANG,
# going by the system prompt); it is saved in the history. One extra model call per chat.
JANNYQ_INTRO=true
# Messages per user per minute (0 = unlimited).
JANNYQ_RATE_LIMIT=20

# --- Misc -------------------------------------------------------------------
SEARXNG_SECRET=change-me-please
JANNYQ_LOG_LEVEL=info
